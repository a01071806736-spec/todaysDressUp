# ==============================================================================
# Vercel & Local Environment Variables
# ==============================================================================
# [Vercel 배포 시 필수 설정]
# Vercel Dashboard -> Project -> Settings -> Environment Variables 에 아래 키를 등록하세요.
#
# 1. GEMINI_API_KEY (필수, 서버 전용)
#    - Google AI Studio에서 발급받은 Gemini API 키를 입력합니다.
#    - /api/recommend-outfit Serverless Function(process.env.GEMINI_API_KEY)에서만 사용됩니다.
#    - 보안상 절대 VITE_ 접두사를 붙이지 마세요! (브라우저 번들에 노출되면 안 됩니다.)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. APP_URL (선택, AI Studio 호환용)
#    - 로컬 및 AI Studio 런타임에서 호스팅 URL 참조 시 사용됩니다.
APP_URL="MY_APP_URL"
